CREATE DATABASE db_uts_nimanda;
USE db_uts_nimanda;

CREATE TABLE buku (
    id_buku INT(11) NOT NULL AUTO_INCREMENT PRIMARY KEY,
    isbn VARCHAR(20) UNIQUE,
    judul VARCHAR(100) NOT NULL,
    penulis VARCHAR(50) NOT NULL,
    penerbit VARCHAR(50) NULL,
    kategori VARCHAR(30) NULL,
    tahun_terbit YEAR(4) NULL,
    harga DECIMAL(10,2) DEFAULT 0.00,
    stok INT(11) DEFAULT 1,
    bahasa VARCHAR(20) DEFAULT 'Indonesia',
    rak VARCHAR(10) NULL,
    tgl_masuk DATE NULL,
    status ENUM('tersedia', 'habis', 'rusak', 'arsip') DEFAULT 'tersedia',
    rating DECIMAL(2,1) DEFAULT 0.8
);

DESCRIBE buku;

